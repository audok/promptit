#!/usr/bin/env bash

set -euo pipefail

blocked_files="$(
  git diff --cached --name-only --diff-filter=ACMR \
    | awk -F/ '$0 ~ /^\.codex\// || $0 == "AGENTS.md" || $0 == "PLANS.md" || $NF ~ /^__/ { print }'
)"

if [[ -z "$blocked_files" ]]; then
  exit 0
fi

echo "Commit blocked: local Codex files, files under '.codex/', or files starting with '__' cannot be committed."
echo "Unstage or rename these files before committing:"
printf '%s\n' "$blocked_files"
exit 1
